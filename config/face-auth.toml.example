# Face Authentication Configuration
# Copy to /etc/face-auth.toml (system) or ~/.config/face-auth.toml (user)
# Environment variables FACE_AUTH_* take precedence

# IR camera device path (auto-detected if not set)
# device = "/dev/video3"

# Cosine similarity threshold (0.0 - 1.0, lower = more permissive)
threshold = 0.6

# ONNX model path (default: /usr/local/share/face-auth/w600k_mbf.onnx)
# model_path = "/usr/local/share/face-auth/w600k_mbf.onnx"

# Embeddings storage directory
# embeddings_dir = "/var/lib/face-auth"

# Camera capture timeout in milliseconds (default: 5000)
# Set to 0 for infinite wait (not recommended)
capture_timeout_ms = 5000

# Face detection ONNX model path (default: /usr/local/share/face-auth/version-slim-320.onnx)
# detector_model_path = "/usr/local/share/face-auth/version-slim-320.onnx"

# Face detection confidence threshold (0.0 - 1.0, higher = stricter)
detector_threshold = 0.5

# How long the face scan window lasts, in milliseconds (default: 5000)
# The scanner keeps capturing and checking frames until this elapses
# or a match is found. Like Windows Hello behaviour.
scan_duration_ms = 5000

# Delay between capture attempts within a scan window, in milliseconds.
# If unset, this is queried from the camera's own reported native frame interval via V4L2 —
# there's no point sleeping longer than the driver's own frame rate, and different hardware
# reports very different native rates. Uncomment to force a fixed value instead.
# scan_interval_ms = 200

# Inference backend: "tract" (portable CPU, default) or "openvino" (Intel NPU/GPU/CPU
# via OpenVINO). "openvino" only works if the binary was built with the `npu` Cargo
# feature and OpenVINO's runtime libraries are installed system-wide — deploy.sh sets
# this automatically when it detects both at build time, so you normally shouldn't need
# to touch this by hand.
# backend = "tract"

# OpenVINO device to run on when backend = "openvino": "NPU", "GPU", or "CPU".
# npu_device = "NPU"