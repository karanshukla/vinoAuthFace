# Face Authentication Configuration
#
# This file is the SYSTEM configuration: /etc/face-auth.toml
# It must stay root-owned. It is the only source the PAM authentication path
# trusts for the camera, the models, and the template directory.
#
# Most installs never edit it. The settings people actually change are in
# "Everyday settings" and "Liveness". The rest is written by deploy.sh and
# pin-camera.sh, or is a safe default.
#
# Grouped keys (liveness.*, lockout.*, guards.*) are written dotted, not as
# [table] headers, on purpose: deploy.sh and pin-camera.sh append plain keys to
# the end of this file, and after a [table] header those would land inside it.
# The old flat spellings (liveness_motion_threshold, lockout_threshold,
# seat_check, ...) still work; a flat key wins over its grouped spelling.
#
# Users may also keep ~/.config/face-auth.toml. At the login and sudo prompt
# that file may only ever make authentication STRICTER:
#
#   threshold, detector_threshold,
#   liveness.motion_threshold,
#   liveness.residual_motion_threshold,
#   liveness.preset                 honoured only if it is not looser than the
#   min_face_size_ratio             value set here
#   device                          honoured only if it is a real IR capture
#                                   device present on this machine
#   scan_duration_ms, scan_interval_ms, capture_timeout_ms,
#   liveness.grace_ms               honoured within built-in bounds
#   model_path, detector_model_path, embeddings_dir,
#   pinned_camera_*, lockout.*, backend, npu_device,
#   liveness.window_ms, bind_camera, seal_embeddings, guards.*
#                                   ignored — system policy only
#
# FACE_AUTH_* environment variables affect the vinoauthface CLI run as a normal
# user and the offline tools, under the flat names
# (FACE_AUTH_LIVENESS_MOTION_THRESHOLD). They are ignored entirely during PAM
# authentication, and by enrolment as root, which reads this file only.

# ---------------------------------------------------------------------------
# Everyday settings
# ---------------------------------------------------------------------------

# Cosine similarity threshold (0.3 - 1.0, HIGHER = stricter match).
# This is the floor: a user cannot go below it, only above.
threshold = 0.6

# How long the face scan window lasts, in milliseconds (500 - 30000, default 5000).
# The scanner keeps capturing and checking frames until this elapses or a match
# is found, like Windows Hello.
scan_duration_ms = 5000

# Start delay (ms, 0 - 10000, default 2000, 0 disables). A screen locker runs
# vinoAuthFace the instant it starts, so someone still at the camera after
# locking would be unlocked at once. vinoAuthFace waits until the locker
# (its parent process) has been running this long, then scans. A retry on the
# same lock screen does not wait again. System policy only.
# guards.start_delay_ms = 2000

# ---------------------------------------------------------------------------
# Liveness (motion check)
# ---------------------------------------------------------------------------
# During a scan, a match is only accepted once one face frame shows the motion
# below. Only the face region is compared, after removing brightness and
# contrast differences, so movement elsewhere in view and auto-exposure changes
# don't count. A user's own config may only raise these.
#
# Start with the preset. "off" turns motion liveness off (a photo or a screen
# replay can then unlock); "standard" is the default; "strict" adds the
# residual check (a photo moved by hand). Sitting very still and failing to
# unlock is a reason to lower the preset, not to raise the scan time. Any of
# the individual keys below overrides the preset for that value.
# liveness.preset = "standard"
#
# Fraction of face pixels that changed (0.0 - 1.0, default 0.01), against the
# oldest face frame of the scan within liveness.window_ms. Defeats a rigidly
# held photo. 0 disables it.
# liveness.motion_threshold = 0.01
#
# Motion a rigid shift can't explain between consecutive face frames (0.0 -
# 1.0, default 0 = off): the fraction still changed, after undoing the best
# shift, in the most-changed eye-sized block of the face. A photo moved by hand
# moves as one piece; a real face moves in parts (a blink, the mouth, the head
# turning). Moved-photo tests peak around 0.2 and blinks reach 0.3-0.6, so 0.3
# is the value to try. Off by default: a face held still may not blink within
# one scan, and glasses glare over the eyes hides blinks.
# liveness.residual_motion_threshold = 0.0
#
# How far back the motion_threshold comparison looks, in milliseconds (0 -
# 2000, default 1000). A face held still barely changes between consecutive
# frames but drifts measurably over a second; a photo doesn't change against
# any frame. 0 compares consecutive frames only. System policy only.
# liveness.window_ms = 1000
#
# Extra scan time, in milliseconds (0 - 10000, default 4000), used once and only
# when a face has already matched but hasn't moved enough yet. A face held
# still can take longer than the scan to blink or shift; this waits for it
# instead of failing. A scan that never matched (nobody there, or someone
# else) still ends after scan_duration_ms. 0 disables it.
# liveness.grace_ms = 4000

# ---------------------------------------------------------------------------
# Lockout
# ---------------------------------------------------------------------------
# Backoff after repeated failed face attempts. A scan counts as failed once it
# sees a face, unless it then matches; one with nobody at the camera doesn't.
# Only throttles the face check: PAM still falls through to the password
# prompt, and a locked-out attempt sleeps at most 3s before doing so.
# System policy only; ignored in a user's own config.
# lockout.threshold = 5          # failures allowed before any cooldown
# lockout.base_delay_ms = 2000   # first cooldown, doubles per further failure
# lockout.max_delay_ms = 300000  # cooldown ceiling

# ---------------------------------------------------------------------------
# Guards (when a scan runs at all). System policy only.
# ---------------------------------------------------------------------------
# Only authenticate the account that owns the active session on seat0 (any
# account while seat0 shows a login greeter). Stops a sudo in a background or
# fast-switched session matching whoever is at the camera. Skipped on systems
# without logind. Default false: it also declines root as the target (sudo's
# targetpw/rootpw, polkit asking for root).
# guards.seat_check = false

# Skip the scan, straight to the password, where it can't succeed.
# abort_if_ssh (default true): any ancestor process is sshd. Nobody is at the
# camera, and sudo over SSH doesn't set PAM_RHOST.
# abort_if_lid_closed (default false): an ACPI lid is closed and the camera's
# USB port isn't reported removable. Leave off for an external IR camera
# behind a hub.
# guards.abort_if_ssh = true
# guards.abort_if_lid_closed = false

# start_delay_scope: "screen_lock" (default; sudo, polkit and login are not
# delayed) or "all". Decided from PAM_SERVICE; unknown services count as
# screen lockers. See guards.start_delay_ms above.
# guards.start_delay_scope = "screen_lock"

# Confirm with Enter (default false). After a face match for sudo, su or polkit,
# vinoAuthFace asks for Enter on the terminal before it lets the caller through, so
# a process that runs `sudo` while you sit in front of the camera cannot get
# root unnoticed. Waits 20 s, and any other key declines. Not asked when there
# is no terminal (pkexec from a GUI), and never on lock screens or login.
# guards.require_confirmation_elevation = false

# ---------------------------------------------------------------------------
# Install and hardware (written by deploy.sh and pin-camera.sh; rarely hand-edited)
# ---------------------------------------------------------------------------

# IR camera device path.
#
# Leave this unset unless you have a reason not to: auto-detection opens each
# IR-named node and picks the first that is really a GREY capture device. UVC
# cameras usually expose a metadata node right next to the capture node (e.g.
# /dev/video2 captures, /dev/video3 does not), and guessing wrong here is the
# most common setup mistake. If none qualifies, face auth declines (no guessing
# /dev/video0, usually the RGB webcam). Run `cargo run --example detect-camera`
# to see what your hardware exposes.
#
# Auto-detection never picks a virtual (v4l2loopback) camera, and a user's own
# config can't select one. Setting it here can, which is only for testing.
# device = "/dev/video2"

# Recognition model path (default: /usr/local/share/face-auth/w600k_mbf.onnx).
# deploy.sh sets this to w600k_r50.onnx for an NPU build, or with
# FACE_AUTH_RECOGNITION_MODEL=r50.
# Changing models requires re-enrolling; vinoAuthFace refuses templates made
# with a different model.
# model_path = "/usr/local/share/face-auth/w600k_mbf.onnx"

# Template storage directory. Must be root-owned (deploy.sh makes it
# root:face-auth 2750) — anything that can write here can choose whose face
# unlocks an account.
# embeddings_dir = "/var/lib/face-auth"

# Seal stored face templates to this machine's TPM (systemd-creds, no PCR
# policy, so firmware updates don't lose your enrolment). Protects a stolen or
# imaged disk, not a running system. With it on, an unsealed template file is
# refused, and a sealed one whose TPM was cleared needs re-enrolling. No TPM
# means enrolment warns and stores unsealed. Existing templates are sealed by
# `vinoauthface improve` (or a fresh enrol). See docs/security.md.
# System policy only; ignored in a user's own config.
# seal_embeddings = false

# Only accept frames from a camera the user enrolled on, by USB vendor:product
# ID (recorded at every enrolment). Another camera plugged in to stand in for
# the IR sensor is refused and PAM falls through to the password; re-enrol
# after replacing the camera on purpose. Accounts enrolled before this setting
# existed, or on a camera with no USB ID (MIPI), accept any camera until their
# next enrolment. Not attestation: a programmable USB device can claim any ID,
# which pin-camera.sh's port pin covers. System policy only.
# bind_camera = true

# Camera pin, written by pin-camera.sh. When set, vinoAuthFace refuses frames
# unless `device` resolves to this exact USB port and V4L2 index. Do not
# hand-edit; re-run pin-camera.sh after intentionally changing hardware.
# System policy only.
# pinned_camera_path = "/sys/devices/pci0000:00/0000:00:14.0/usb3/3-7/3-7:1.2"
# pinned_camera_index = 0

# Inference backend: "tract" (default, pure-Rust CPU, works in the static musl
# build) or "openvino" (needs a build with the `npu` feature, which deploy.sh
# does automatically when it finds an OpenVINO install, and keeps in sync).
# backend = "tract"
# OpenVINO device when backend = "openvino": "NPU", "GPU" or "CPU".
# npu_device = "NPU"

# ---------------------------------------------------------------------------
# Advanced (the defaults are right for nearly everyone)
# ---------------------------------------------------------------------------

# Camera capture timeout in milliseconds (100 - 30000, default 5000)
capture_timeout_ms = 5000

# Face detection ONNX model path (default: /usr/local/share/face-auth/det_500m.onnx,
# SCRFD, whose landmarks align the face before matching; falls back to the older
# box-only version-slim-320.onnx if det_500m.onnx isn't installed). Changing the
# detector means re-enrolling.
# detector_model_path = "/usr/local/share/face-auth/det_500m.onnx"

# Face detection confidence threshold (0.05 - 1.0, higher = stricter)
detector_threshold = 0.5

# Extra delay between capture attempts within a scan window, in milliseconds
# (0 - 5000, default 0).
#
# Zero is right for almost everyone: the scan loop is already paced by the
# camera and by inference, so it cannot spin. Raise it only to trade unlock
# speed for CPU.
scan_interval_ms = 0

# Minimum face size (0.0 - 0.75, default 0 = off). The larger side of the
# detected face box, as a fraction of the same side of the frame. Smaller faces
# are ignored at login and rejected at enrolment ("face too small, move
# closer"). A user's own config may only raise it.
# min_face_size_ratio = 0.0

# Update check (default true). `vinoauthface doctor` and the tray icon ask
# GitHub's public releases API (through curl) whether a newer release exists,
# and say so. One anonymous request, which reveals only your IP address to
# GitHub; the tray asks once a day. Never part of authentication. Dev builds
# (VINOAUTHFACE_VERSION unset) never check. System policy only.
# update_check = true

# Tray icon idle delay, in minutes (default 30). After this long with no scan,
# action or status change, the tray icon reports itself Passive and Plasma
# tucks it behind the panel's arrow. 0 keeps it in view. Also honoured from
# ~/.config/face-auth.toml, which the tray's Settings menu writes; never part of
# authentication.
# tray_idle_minutes = 30
