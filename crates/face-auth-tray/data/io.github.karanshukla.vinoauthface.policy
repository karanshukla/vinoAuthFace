<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  The tray's three root actions. Each pins both the binary (exec.path) and
  its only argument (the first-argument annotation), so pkexec cannot be pointed at vinoauthface
  with caller-chosen flags. The helper acts only for PKEXEC_UID.
  auth_admin, never yes: every action changes who a face unlocks.
-->
<policyconfig>
  <vendor>vinoAuthFace</vendor>
  <vendor_url>https://github.com/karanshukla/vinoAuthFace</vendor_url>
  <icon_name>vinoauthface</icon_name>

  <action id="io.github.karanshukla.vinoauthface.enrol">
    <description>Enrol your face for face unlock</description>
    <message>Authentication is required to enrol your face</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">enrol</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.retrain">
    <description>Add frames to your enrolled face</description>
    <message>Authentication is required to retrain your face</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">retrain</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.uninstall">
    <description>Uninstall vinoAuthFace</description>
    <message>Authentication is required to uninstall vinoAuthFace</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">uninstall</annotate>
  </action>
</policyconfig>
