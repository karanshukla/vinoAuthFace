    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-delay-off</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-delay-1s">
    <description>Change lock screen start delay: 1 second</description>
    <message>Authentication is required to change lock screen start delay</message>
