    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-scan-8s</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-scan-12s">
    <description>Change scan time: 12 seconds</description>
    <message>Authentication is required to change scan time</message>
    <defaults>
      <allow_any>no</allow_any>
