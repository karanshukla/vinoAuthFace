    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-minface-close</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-delay-off">
