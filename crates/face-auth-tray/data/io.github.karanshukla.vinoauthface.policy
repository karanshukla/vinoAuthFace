<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  The tray's root actions. Each pins both the binary (exec.path) and
  its only argument (the first-argument annotation), so pkexec cannot be pointed at vinoauthface
  with caller-chosen flags. The helper acts only for PKEXEC_UID.
  auth_admin, never yes: every action changes who a face unlocks, what unlocks the login
  screen, how strict matching is, or (upgrade) runs a downloaded deploy.sh as root.
-->
<policyconfig>
  <vendor>vinoAuthFace</vendor>
  <vendor_url>https://github.com/karanshukla/vinoAuthFace</vendor_url>
  <icon_name>vinoauthface</icon_name>

  <action id="io.github.karanshukla.vinoauthface.enrol">
    <description>Enrol your face for face unlock</description>
    <message>Authentication is required to enrol your face</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">enrol</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.retrain">
    <description>Add frames to your enrolled face</description>
    <message>Authentication is required to retrain your face</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">retrain</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.uninstall">
    <description>Uninstall vinoAuthFace</description>
    <message>Authentication is required to uninstall vinoAuthFace</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">uninstall</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.upgrade">
    <description>Upgrade vinoAuthFace to the newest release</description>
    <message>Authentication is required to upgrade vinoAuthFace</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">upgrade</annotate>
  </action>
  <action id="io.github.karanshukla.vinoauthface.login-off">
    <description>Turn off face unlock at the login screen</description>
    <message>Authentication is required to turn off face unlock at the login screen</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">login-off</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.login-both">
    <description>Require your password and face at the login screen</description>
    <message>Authentication is required to change how the login screen authenticates</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">login-both</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.login-face">
    <description>Unlock the login screen with your face</description>
    <message>Authentication is required to turn on face unlock at the login screen</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">login-face</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-security-convenient">
    <description>Change face unlock security: Convenient</description>
    <message>Authentication is required to change face unlock security</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-security-convenient</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-security-balanced">
    <description>Change face unlock security: Balanced</description>
    <message>Authentication is required to change face unlock security</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-security-balanced</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-security-strict">
    <description>Change face unlock security: Strict</description>
    <message>Authentication is required to change face unlock security</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-security-strict</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-scan-3s">
    <description>Change scan time: 3 seconds</description>
    <message>Authentication is required to change scan time</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-scan-3s</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-scan-5s">
    <description>Change scan time: 5 seconds</description>
    <message>Authentication is required to change scan time</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-scan-5s</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-scan-8s">
    <description>Change scan time: 8 seconds</description>
    <message>Authentication is required to change scan time</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-scan-8s</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-scan-12s">
    <description>Change scan time: 12 seconds</description>
    <message>Authentication is required to change scan time</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-scan-12s</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-confirm-off">
    <description>Change sudo confirmation: Off</description>
    <message>Authentication is required to change sudo confirmation</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-confirm-off</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-confirm-on">
    <description>Change sudo confirmation: On</description>
    <message>Authentication is required to change sudo confirmation</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-confirm-on</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-updates-on">
    <description>Change update checks: On</description>
    <message>Authentication is required to change update checks</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-updates-on</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-updates-off">
    <description>Change update checks: Off</description>
    <message>Authentication is required to change update checks</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-updates-off</annotate>
  </action>
</policyconfig>
