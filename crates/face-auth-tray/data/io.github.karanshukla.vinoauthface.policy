  </action>

  <action id="io.github.karanshukla.vinoauthface.set-match-strict">
    <description>Change match strictness: Strict (0.7)</description>
    <message>Authentication is required to change match strictness</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vinoauthface-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-match-strict</annotate>
  </action>

  <action id="io.github.karanshukla.vinoauthface.set-scan-3s">
